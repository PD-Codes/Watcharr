{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": false },
  "files": {
    // The two locale dictionaries are generated by `npm run i18n:build`.
    "includes": ["src/**", "scripts/**", "!src/i18n/en-US.json", "!src/i18n/de-DE.json"]
  },
  // Lint only: the code keeps its own formatting, nothing is rewritten.
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Style is a matter of taste; this linter is here to catch bugs.
      "style": "off",
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "error"
      },
      "suspicious": {
        // Position keys only appear on static renders that never reorder (hours of a day, chart
        // cells, calendar blanks, perforations, the words of a split string); most of them have
        // no other value that would be unique.
        "noArrayIndexKey": "off"
      },
      "performance": {
        // Artwork is served by the app's own proxy (/api/art) so no media server token reaches
        // a browser; next/image would put its optimizer in front of that proxy as a second
        // fetching layer and needs every source host configured up front.
        "noImgElement": "off"
      },
      "complexity": {
        // !important appears only in prefers-reduced-motion overrides, where it has to beat
        // every animation declared anywhere else.
        "noImportantStyles": "off"
      }
    }
  }
}
