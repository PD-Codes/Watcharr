# Path to the SQLite database file. Docker Compose overrides this with /app/data/watcharr.db.
DATABASE_PATH=./data/watcharr.db

# Secret used to sign session cookies and to encrypt media server tokens at rest.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Public base URL of this deployment: the address you actually open in the browser.
# Used for the artwork links in Discord/Slack notifications and as an accepted origin for
# state-changing requests. Behind a TLS-terminating reverse proxy, the proxy must send
# X-Forwarded-Proto: https, otherwise the session cookie is not marked Secure.
# Example for a LAN deployment: APP_URL=http://192.168.1.10:3000
APP_URL=http://localhost:3000

# Folder a "script" notification channel may run files from. Nothing outside it is
# reachable: a channel names a plain file name, never a path.
# WATCHARR_SCRIPTS_DIR=./data/scripts

# Set to 1 to run the container as a web front end only: no live event sockets and no
# background sync. Only useful alongside another instance that does the work.
# WATCHARR_NO_BACKGROUND=1

# Set to 0 only if the media server uses a self-signed certificate.
# NODE_TLS_REJECT_UNAUTHORIZED=0
